# MongoDB connection string. Local: mongodb://127.0.0.1:27017/clutch (not "localhost": it resolves to IPv6 ::1, which rootless podman resets)  Atlas: mongodb+srv://user:pass@cluster/clutch
MONGODB_URI=mongodb://127.0.0.1:27017/clutch
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL of the site, no trailing slash
BETTER_AUTH_URL=http://localhost:3000
# SMTP connection string for Nodemailer: smtp://user:pass@host:587, or smtps://... for implicit TLS on 465.
# Gmail wants an app password, not the account password. Leave empty in dev: mail is printed to the server log instead.
SMTP_URL=
EMAIL_FROM=Clutch <noreply@yourdomain.com>
# No admin env var: the role lives on the user document. Sign up, then `npm run promote you@example.com`.
