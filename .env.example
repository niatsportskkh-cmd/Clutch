# MongoDB connection string. Local: mongodb://127.0.0.1:27017/clutch (not "localhost": it resolves to IPv6 ::1, which rootless podman resets)  Atlas: mongodb+srv://user:pass@cluster/clutch
MONGODB_URI=mongodb://127.0.0.1:27017/clutch
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL of the site, no trailing slash
BETTER_AUTH_URL=http://localhost:3000
# SMTP connection string for Nodemailer: smtp://user:pass@host:587, or smtps://... for implicit TLS on 465.
# Gmail wants an app password, not the account password. Leave empty in dev: mail is printed to the server log instead.
SMTP_URL=
EMAIL_FROM=Clutch <noreply@yourdomain.com>
# No admin env var: the role lives on the user document. Sign up, then `npm run promote you@example.com`.

# The first admin, created automatically when the server starts, from these five values — the whole
# sign-up form. The account skips the student-list check and gets the admin role, which is the only
# way into /admin on a fresh database: no students are loaded yet, so nobody can sign up normally.
# It gets no college, so it runs the panel but can never be put on a team.
# Name/phone/college ID are optional and default to Admin / 0000000000 / ADMIN.
# Leave email and password empty to switch it off and use `npm run promote` instead.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_COLLEGE_ID=

